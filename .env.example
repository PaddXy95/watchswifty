# WatchSwifty – settings for docker compose. Put this file next to docker-compose.yml as `.env`.
# The real .env contains secrets: don't commit it, don't share it (it is in .gitignore).

# Image version: `latest` = always the newest release; `0.1` = patch updates only; `0.1.1` = exactly this version.
# Don't enter `beta` here; run a separate instance instead (docs/releases.md, "Testing a beta").
WATCHSWIFTY_VERSION=latest

# Port on the server (http://<server>:8080).
WATCHSWIFTY_PORT=8080

# Required: key for the encrypted TMDB tokens and other secrets. Create it with:
#   openssl rand -base64 32
# Keep it safe (for example in a password manager). If it is lost, every user has to enter their TMDB token again.
TOKEN_KEY=

# First admin – only created on the very first start (password at least 8 characters), ignored afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Time zone for "today".
TZ=Europe/Berlin

# Language of the TMDB data.
TMDB_LANGUAGE=de-DE

# Only behind a reverse proxy with its own address, for example https://watch.example.lan (otherwise leave empty).
PUBLIC_ORIGIN=

# Single sign-on (OIDC) is set up in the web UI under System (docs/sso.md).
# Emergency switch if you locked yourself out: forces password login until removed.
# PASSWORD_LOGIN=true
