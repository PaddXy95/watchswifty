# WatchSwifty – Einstellungen für docker compose. Als `.env` neben die docker-compose.yml legen.
# Die echte .env enthält Geheimnisse: nicht einchecken, nicht teilen (steht in .gitignore).

# Image-Version: `latest` = immer das neueste Release; `0.1` = nur Patch-Updates; `0.1.1` = genau diese Version.
# Für die Beta nicht hier `beta` eintragen, sondern eine eigene Instanz anlegen (README, „Beta-Version testen“).
WATCHSWIFTY_VERSION=latest

# Port auf dem Server (http://<server>:8080).
WATCHSWIFTY_PORT=8080

# Pflicht: Schlüssel für die verschlüsselt gespeicherten TMDB-Tokens. Erzeugen mit:
#   openssl rand -base64 32
# Gut aufbewahren (z. B. Passwortmanager). Geht er verloren, muss jeder seinen TMDB-Token neu eintragen.
TOKEN_KEY=

# Erster Admin – wird nur beim allerersten Start angelegt (Passwort mind. 8 Zeichen), danach ignoriert.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Zeitzone für „heute“.
TZ=Europe/Berlin

# Sprache der TMDB-Daten.
TMDB_LANGUAGE=de-DE

# Nur hinter einem Reverse-Proxy mit eigener Adresse, z. B. https://watch.example.lan (sonst leer lassen).
PUBLIC_ORIGIN=

# Anmeldung über OIDC (SSO) wird unter System eingerichtet (README, „Anmeldung über OIDC“).
# Notschalter, falls man sich ausgesperrt hat: erzwingt den Passwort-Login bis zum Entfernen.
# PASSWORD_LOGIN=true
